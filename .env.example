# Konfiguracja Budżetu Domowego. Skopiuj do .env (albo uruchom ./deploy.sh init-env).
# Plik .env zawiera sekrety – NIE trafia do repozytorium (.gitignore).

# ---- Serwer (malinka) ----
# Port na hoście (8097 zajmuje Jellyfin).
BUDZET_HOST_PORT=8420
# Katalog na bazę i kopie zapasowe (dysk SSD).
BUDZET_DATA_PATH=/mnt/dietpi_userdata/budzet
TZ=Europe/Warsaw

# ---- Konta ----
# Hash hasła generuje: ./deploy.sh hash-password
# WAŻNE: hash zawiera znaki $, dlatego musi być w pojedynczych cudzysłowach '…'
# (inaczej Docker Compose potraktuje $… jak zmienną).
BUDZET_USER1_NAME=Daniel
BUDZET_USER1_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$ZAMIEN$MNIE'
BUDZET_USER2_NAME=Partnerka
BUDZET_USER2_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$ZAMIEN$MNIE'

# Po ilu dniach nieużywania sesja wygasa (trzeba zalogować się ponownie).
BUDZET_SESSION_DAYS=30
# true tylko, jeśli aplikacja działa za HTTPS (np. tailscale serve).
BUDZET_COOKIE_SECURE=false

# ---- Kopie zapasowe ----
# Codzienna kopia po tej godzinie (czas lokalny) i ile ostatnich trzymać.
BUDZET_BACKUP_HOUR=3
BUDZET_BACKUP_KEEP=14
